        android:pathData="M3,4h18v3H3z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M3,10.5h18v3H3z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M3,17h18v3H3z" />
</vector>
