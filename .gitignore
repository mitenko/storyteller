# --- Secrets ---------------------------------------------------------------
# Holds the Anthropic and ElevenLabs API keys, injected into BuildConfig at
# build time. Must never be committed.
local.properties
*.keystore
*.jks

# --- Android / Gradle ------------------------------------------------------
.gradle/
build/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties.bak
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# --- IDE -------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.kotlin/

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Eval fixtures ---------------------------------------------------------
# Photos of real book pages used by the vision eval harness: potentially
# copyrighted material, and large. Keep them local.
evals/fixtures/

# Cygwin/MSYS crash debris
*.stackdump

# Diagnostic bundles pulled off the device. These hold photographs of copyrighted
# book pages and must never be committed - this repository is public. The
# measurement OUTPUT derived from them is committed instead, under scripts/fixtures.
diagnostics-pulled/

# Runtime traceback dropped beside a failing script by the repo Python convention.
scripts/error.txt

# Python bytecode from running the scripts in scripts/.
__pycache__/
